function actualizarEstado(id_usuario){
	query('UPDATE usuario SET estado = 1 WHERE id_usuario = ?', [id_usuario], 
		function (tx, response){
			if (response.rows.length >= 1) {
				console.log('Estado de usuario actualizado.');
			}
		}, function (tx, response) {
