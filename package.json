{
  "name": "com.medichile.app",
  "displayName": "MED-SDI",
  "version": "1.0.1",
  "description": "Aplicación móvil de Salud Digital Integrada.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Salud Digital Integrada",
  "license": "Apache-2.0",
  "devDependencies": {
    "cordova-android": "^14.0.1",
    "cordova-browser": "^7.0.0",
    "cordova-plugin-dialogs": "^2.0.2",
    "cordova-plugin-firebasex-core": "^2.0.0",
    "cordova-plugin-firebasex-messaging": "^2.0.1",
    "cordova-plugin-inappbrowser": "^6.0.0"
  },
  "cordova": {
    "platforms": [
      "browser",
      "android"
    ],
    "plugins": {
      "cordova-plugin-inappbrowser": {},
      "cordova-plugin-firebasex-core": {},
      "cordova-plugin-firebasex-messaging": {
        "FIREBASE_FCM_AUTOINIT_ENABLED": "true",
        "FIREBASE_MESSAGING_IMMEDIATE_PAYLOAD_DELIVERY": "false",
        "IOS_FCM_ENABLED": "true",
        "IOS_ENABLE_CRITICAL_ALERTS_ENABLED": "false"
      },
      "cordova-plugin-dialogs": {},
      "cordova-plugin-fingerprint-aio": {}
    }
  },
  "dependencies": {
    "cordova-plugin-fingerprint-aio": "6.0.1"
  }
}